# Base URL of the Vacatime Spring API (server-side only; the browser never talks to it directly)
API_URL=http://localhost:8080

# Public origin of the frontend, baked in at build time (kit.paths.origin).
# Used for CSRF checks of forms/remote functions and the cookie `secure` flag.
# Behind a reverse proxy you can leave it empty and set PROTOCOL_HEADER/HOST_HEADER instead.
ORIGIN=http://localhost:3000
