{
	"name": "vacatime",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && bun run i18n || echo ''",
		"check": "bun run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "bun run test:unit --run && bun run test:e2e",
		"test:e2e": "playwright test",
		"start": "node build",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@fontsource-variable/onest": "5.3.1",
		"@inlang/paraglide-js": "2.25.4",
		"@inlang/plugin-message-format": "4.4.4",
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "^1.52.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "6.0.0",
		"@sveltejs/kit": "3.0.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "^1.4.2",
		"@types/node": "22",
		"@vitest/browser-playwright": "^4.1.8",
		"bits-ui": "2.19.5",
		"cn": "^0.4.0",
		"mode-watcher": "1.1.0",
		"playwright": "^1.60.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "5.57.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "1.2.1",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "8.3.2",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"zod": "4.6.5"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=22.17"
	}
}
