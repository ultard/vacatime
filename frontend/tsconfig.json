{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		"types": ["$app/types", "node", "vite/client", "bun"],
		"noUncheckedIndexedAccess": false
	},
	"include": ["src", "test", "e2e", "mock-api", "scripts", "*"],
	"exclude": ["src/service-worker", "build", "node_modules"]
}
